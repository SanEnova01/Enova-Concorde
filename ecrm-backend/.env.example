# Variables del backend (Railway → Enova-Concorde → Variables). Copiar a .env para desarrollo local.
# Nunca subir valores reales al repositorio.

# --- Obligatorias ---
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Secreto para firmar sesiones. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Llave compartida con el bot (debe ser IGUAL a la API_KEY del servicio Concorde Analizer)
API_KEY=

# --- Opcionales ---
# Llave anterior aceptada temporalmente mientras se rota API_KEY
API_KEY_PREVIOUS=
# Dominios del frontend separados por coma (por defecto: los de Railway y localhost)
CORS_ORIGINS=
PORT=8080
# URL interna del bot (Concorde Analizer)
BOT_SERVICE_URL=

# Correo de fin de escaneo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# IA
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
AI_GATEWAY_URL=
# Análisis de IA en paralelo durante el escaneo masivo (por defecto 2)
AI_HTML_CONCURRENCY=2

# Gmail (triage de correos → tickets)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Cada cuántos segundos se revisa Gmail (por defecto 30, mínimo 10)
GMAIL_POLL_SECONDS=30

# Integraciones
HUBSPOT_ACCESS_TOKEN=
CONCORDE_WEBHOOK_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
GOOGLE_PAGESPEED_API_KEY=
