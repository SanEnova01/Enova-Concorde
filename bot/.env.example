# Variables del bot (Railway → Concorde Analizer → Variables). Nunca subir valores reales.

# URL de la API del backend, terminada en /api
API_BASE_URL=
# Debe ser IGUAL a la API_KEY del backend
API_KEY=
# Caché del último valor válido por tienda (en Railway apunta al volumen)
METRICS_CACHE_PATH=/data/ultimas_metricas.json
PORT=3001

# Solo en Railway (no en .env): RAILPACK_DEPLOY_APT_PACKAGES debe conservar los paquetes
# de Chrome y agregar tini, y el Start Command es: tini -- node server-bot.js
